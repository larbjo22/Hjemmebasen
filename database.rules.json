{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "brukere": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "sistSett": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        },
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('kode').isString() && newData.child('familieId').isString() && newData.child('kode').val() === root.child('familier').child(newData.child('familieId').val()).child('meta').child('invitasjonskode').val() && (!root.child('familier').child(newData.child('familieId').val()).child('meta').child('invitasjonUtloper').exists() || root.child('familier').child(newData.child('familieId').val()).child('meta').child('invitasjonUtloper').val() > now)))",
        "innstillinger": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "familier": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$familieId": {
        ".read": "auth != null && root.child('brukere').child(auth.uid).child('familieId').val() === $familieId",
        ".write": "auth != null && root.child('brukere').child(auth.uid).child('familieId').val() === $familieId",
        "avatarer": {
          "$navn": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 80000 && newData.val().beginsWith('data:image/') && !newData.val().contains('\"') && !newData.val().contains(')') && !newData.val().contains('<'))"
          }
        }
      }
    }
  }
}