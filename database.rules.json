{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "brukere": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "sistSett": {
          ".write": "auth != null && auth.uid === $uid"
        },
        ".write": "auth != null && auth.uid === $uid && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('kode').val() != null && newData.child('familieId').val() != null && newData.child('kode').val() === root.child('familier').child(newData.child('familieId').val()).child('meta').child('invitasjonskode').val()))",
        "innstillinger": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "familier": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$familieId": {
        ".read": "auth != null && root.child('brukere').child(auth.uid).child('familieId').val() === $familieId",
        ".write": "auth != null && root.child('brukere').child(auth.uid).child('familieId').val() === $familieId",
        "avatarer": {
          "$navn": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().length < 80000)"
          }
        }
      }
    }
  }
}